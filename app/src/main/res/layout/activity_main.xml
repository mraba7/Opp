<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍"
            android:textSize="40sp"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_light"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اضغط زر واحد يوصل للمندوب العنوان وصورة المنزل مباشرة"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"/>

        <!-- ===== شاشة الإعداد ===== -->
        <LinearLayout
            android:id="@+id/setupLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العنوان"
                android:textColor="@color/muted"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/addressInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:gravity="top|start"
                android:textDirection="rtl"
                android:hint="مثال: حي كذا، شارع كذا، بجانب كذا، رقم المبنى..."
                android:textColorHint="@color/muted"
                android:textColor="@color/text_light"
                android:backgroundTint="@color/muted"
                android:padding="10dp"
                android:layout_marginTop="6dp"/>

            <ImageView
                android:id="@+id/photoPreview"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:scaleType="centerCrop"
                android:background="@color/bg"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/choosePhotoBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اختيار صورة المنزل / البوابة"
                android:backgroundTint="@color/bg"
                android:textColor="@color/text_light"
                android:layout_marginTop="12dp"/>

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="حفظ"
                android:backgroundTint="@color/accent"
                android:textColor="@color/bg"
                android:textStyle="bold"
                android:layout_marginTop="14dp"/>

            <TextView
                android:id="@+id/setupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12.5sp"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- ===== شاشة الإرسال ===== -->
        <LinearLayout
            android:id="@+id/sendLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card"
            android:padding="18dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/savedPhotoView"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:scaleType="centerCrop"
                android:background="@color/bg"/>

            <TextView
                android:id="@+id/savedAddressView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_light"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/sendBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📲 إرسال الموقع لمندوب واتساب"
                android:backgroundTint="@color/accent"
                android:textColor="@color/bg"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="14dp"
                android:layout_marginTop="18dp"/>

            <Button
                android:id="@+id/waTextBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="إرسال نص فقط عبر واتساب"
                android:backgroundTint="@color/bg"
                android:textColor="@color/text_light"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/sendStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12.5sp"
                android:gravity="center"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/editLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعديل العنوان أو الصورة"
                android:textColor="@color/muted"
                android:textSize="12.5sp"
                android:gravity="center"
                android:paddingTop="14dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
