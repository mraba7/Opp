<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍"
            android:textSize="40sp"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_light"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اضغط زر واحد يوصل للمندوب كل التفاصيل والصور مباشرة"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- ===== اختيار العنوان (بروفايل) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/card"
            android:padding="10dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/profileSpinner"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/addProfileBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="＋ جديد"
                android:textSize="12sp"
                android:backgroundTint="@color/accent"
                android:textColor="@color/bg"
                android:layout_marginStart="6dp"/>

            <Button
                android:id="@+id/deleteProfileBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حذف"
                android:textSize="12sp"
                android:backgroundTint="@color/bg"
                android:textColor="@color/muted"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="3">

            <Button
                android:id="@+id/backupExportBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="⬆️ نسخ احتياطي"
                android:textSize="11sp"
                android:backgroundTint="@color/card"
                android:textColor="@color/muted"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/backupImportBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="⬇️ استيراد"
                android:textSize="11sp"
                android:backgroundTint="@color/card"
                android:textColor="@color/muted"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/historyBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="📜 السجل"
                android:textSize="11sp"
                android:backgroundTint="@color/card"
                android:textColor="@color/muted"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- ===== شاشة الإعداد ===== -->
        <LinearLayout
            android:id="@+id/setupLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="رابط الموقع من قوقل مابس"
                android:textColor="@color/muted"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/mapsLinkInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:gravity="start"
                android:textDirection="ltr"
                android:hint="https://maps.app.goo.gl/xxxxx"
                android:textColorHint="@color/muted"
                android:textColor="@color/text_light"
                android:backgroundTint="@color/muted"
                android:padding="10dp"
                android:layout_marginTop="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العنوان الوطني المختصر"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/nationalAddressInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:textDirection="ltr"
                android:gravity="start"
                android:hint="مثال: RRRD1234"
                android:textColorHint="@color/muted"
                android:textColor="@color/text_light"
                android:backgroundTint="@color/muted"
                android:padding="10dp"
                android:layout_marginTop="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="رقم المبنى"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/buildingNumberInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textDirection="ltr"
                android:gravity="start"
                android:hint="مثال: 7845"
                android:textColorHint="@color/muted"
                android:textColor="@color/text_light"
                android:backgroundTint="@color/muted"
                android:padding="10dp"
                android:layout_marginTop="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مكان وضع الشحنة"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/dropOffInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"
                android:gravity="top|start"
                android:textDirection="rtl"
                android:hint="مثال: عند البوابة الرئيسية، بجانب العداد الكهرباء..."
                android:textColorHint="@color/muted"
                android:textColor="@color/text_light"
                android:backgroundTint="@color/muted"
                android:padding="10dp"
                android:layout_marginTop="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صور المنزل / البوابة"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:layout_marginTop="16dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:id="@+id/photoThumbsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:weightSum="2">

                <Button
                    android:id="@+id/choosePhotoBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="إضافة صور"
                    android:backgroundTint="@color/bg"
                    android:textColor="@color/text_light"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/clearPhotosBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="مسح الصور"
                    android:backgroundTint="@color/bg"
                    android:textColor="@color/muted"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="حفظ"
                android:backgroundTint="@color/accent"
                android:textColor="@color/bg"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/setupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12.5sp"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- ===== شاشة الإرسال ===== -->
        <LinearLayout
            android:id="@+id/sendLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card"
            android:padding="18dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/staticMapView"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:scaleType="centerCrop"
                android:background="@color/bg"
                android:visibility="gone"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:id="@+id/savedPhotoThumbsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="إرسال كـ بطاقة مدمجة (صورة واحدة)"
                    android:textColor="@color/muted"
                    android:textSize="12.5sp"/>

                <Switch
                    android:id="@+id/cardModeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <TextView
                android:id="@+id/savedDetailsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_light"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/sendBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📲 إرسال الموقع لمندوب واتساب"
                android:backgroundTint="@color/accent"
                android:textColor="@color/bg"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="14dp"
                android:layout_marginTop="18dp"/>

            <Button
                android:id="@+id/waTextBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="إرسال نص فقط عبر واتساب"
                android:backgroundTint="@color/bg"
                android:textColor="@color/text_light"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/sendStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12.5sp"
                android:gravity="center"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/editLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعديل التفاصيل أو الصور"
                android:textColor="@color/muted"
                android:textSize="12.5sp"
                android:gravity="center"
                android:paddingTop="14dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
